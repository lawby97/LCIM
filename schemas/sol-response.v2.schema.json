{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lcim.local/schemas/sol-response.v2.schema.json",
  "$comment": "Sprint 06 (SOL-S06-004/007/009 repair) \u2014 compiled SOL response (bounded decision result). responseId + askId bind the response to exactly one compiled ask; callType must match the ask; verdict must be one of the call type's verdict vocabulary (enforced in validateSolResponse). amendment carries exact contract amendments (CONTRACT_CHECK only); failure carries root cause/evidence/smallest safe repair/exact tests/falsification (DIAGNOSE only) and compiles deterministically into the Sprint-04 repair/acceptance contract \u2014 authority-bearing required behavior and acceptance semantics are source-derived, never SOL-authored (repair carries only mustChange/mustNotChange/exactTests/verification; objective/violation/requiredBehavior are derived from the source at conversion). findings reference named invariants (FINAL_REVIEW checklist, RECHECK prior finding + named neighbors only) and their evidenceRefs must resolve to retained non-marker evidence. adjacentCriticalDefects allows at most one adjacent critical defect outside the checklist, only under FAIL, with evidenceRefs resolving to retained non-marker evidence and lockedRequirementRef resolving to a bound source requirement. Evidence is bounded by the ask's evidence budget. The schema uses only the Sprint-00 engine subset; cross-field rules are enforced in src/sol/contracts/validate.mjs (validateSolResponse).",
  "title": "LCIM V2 SOL response (bounded decision result)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaName",
    "schemaVersion",
    "responseId",
    "askId",
    "callType",
    "verdict",
    "decisionSummary",
    "evidence",
    "compiledAt"
  ],
  "properties": {
    "schemaName": {
      "const": "lcim.sol-response"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "responseId": {
      "type": "string",
      "pattern": "^lcim_sol_resp_[0-9a-f]{32}$"
    },
    "askId": {
      "type": "string",
      "pattern": "^lcim_sol_ask_[0-9a-f]{32}$"
    },
    "callType": {
      "enum": [
        "SOL_CONTRACT_CHECK",
        "SOL_DIAGNOSE",
        "SOL_FINAL_REVIEW",
        "SOL_RECHECK"
      ]
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "decisionSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "content"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "decisionCritical": {
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "observation",
              "test_result",
              "log_summary",
              "prior_finding",
              "requirement",
              "other"
            ]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "findingId",
          "severity",
          "invariantRef",
          "summary",
          "evidenceRefs"
        ],
        "properties": {
          "findingId": {
            "type": "string",
            "pattern": "^lcim_finding_[0-9a-f]{32}$"
          },
          "severity": {
            "enum": [
              "INFO",
              "WARNING",
              "CRITICAL"
            ]
          },
          "invariantRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      }
    },
    "amendment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactAmendments"
      ],
      "properties": {
        "exactAmendments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contractKey",
              "target",
              "current",
              "exactAmendment",
              "reason"
            ],
            "properties": {
              "contractKey": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "current": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "exactAmendment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootCause",
        "evidenceRefs",
        "repair",
        "falsification"
      ],
      "properties": {
        "rootCause": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "falsification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "repair": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mustChange",
            "mustNotChange",
            "exactTests",
            "verification"
          ],
          "properties": {
            "mustChange": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "target",
                  "change"
                ],
                "properties": {
                  "target": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "change": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              }
            },
            "mustNotChange": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "target",
                  "reason"
                ],
                "properties": {
                  "target": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              }
            },
            "exactTests": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "expectation"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "command": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "expectation": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "acceptanceCriterionRef": {
                    "type": "string",
                    "pattern": "^se_[0-9a-f]{64}$"
                  }
                }
              }
            },
            "verification": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "method",
                  "expectation"
                ],
                "properties": {
                  "method": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "expectation": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              }
            }
          }
        }
      }
    },
    "adjacentCriticalDefects": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "summary",
          "evidenceRefs",
          "lockedRequirementRef"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "lockedRequirementRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "compiledAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lcim.local/schemas/common/common-rejection.v2.schema.json",
  "$comment": "Shared rejection record. rejectionCode is the frozen taxonomy; each code maps to a documented V1 failure class (docs/v1-characterization.md). reason must be bounded and public-safe — never raw transcripts or credentials.",
  "title": "LCIM V2 rejection record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaName",
    "schemaVersion",
    "workUnitId",
    "rejectionCode",
    "reason",
    "evidenceRefs",
    "rejectedAt"
  ],
  "properties": {
    "schemaName": { "const": "lcim.common.rejection" },
    "schemaVersion": { "const": "2.0.0" },
    "workUnitId": { "type": "string", "pattern": "^lcim_wu_[0-9a-f]{32}$" },
    "rejectionCode": {
      "enum": [
        "TRANSPORT_MALFORMED",
        "SCHEMA_MISMATCH",
        "SEMANTIC_CONFLATION",
        "WRONG_BASE",
        "SCOPE_VIOLATION",
        "UNRESOLVED_SEMANTICS",
        "UNSUPPORTED_CLAIM",
        "INCOMPLETE_LEDGER",
        "BUDGET_EXHAUSTED",
        "SECRET_DENIED_PATH",
        "SOL_ASK_INVALID"
      ]
    },
    "reason": { "type": "string", "minLength": 1 },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rejectedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}

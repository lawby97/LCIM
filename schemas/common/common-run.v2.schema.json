{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lcim.local/schemas/common/common-run.v2.schema.json",
  "$comment": "Shared run-record header. Sprint 01 owns the run store and extends this shape; the header fields (LCIM version/commit, target base, config digest, schema version) are recorded per master-plan principle 10.",
  "title": "LCIM V2 shared run record header",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaName",
    "schemaVersion",
    "runId",
    "lifecycleState",
    "lcimVersion",
    "lcimCommit",
    "targetBaseSha",
    "configDigest",
    "createdAt"
  ],
  "properties": {
    "schemaName": { "const": "lcim.common.run" },
    "schemaVersion": { "const": "2.0.0" },
    "runId": { "type": "string", "pattern": "^lcim_run_[0-9a-f]{32}$" },
    "lifecycleState": {
      "enum": ["OPEN", "COMPLETED", "INCOMPLETE_LEDGER", "ABORTED"]
    },
    "lcimVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "lcimCommit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "targetBaseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "configDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lcim.local/schemas/invocation.v2.schema.json",
  "$comment": "Sprint 01 owned: compact invocation record persisted as invocations/<invocationId>.json under the run store (a projection of the append-only ledger, rewritten on each lifecycle transition; the ledger is authoritative and is never mutated). DISTINCT from the frozen shared lcim.common.invocation header: this record adds provider/model/role/reasoning, lifecycle timestamps, status, usage, and error/rejection taxonomy fields. No secrets, no prompt bodies, no raw model output, and never a synthesized workerStatus (worker status vocabulary stays in the shared invocation header, Sprint 02 owns its semantics). Conditional rule enforced in src/logging/schemas.mjs: when assessmentResult is REJECTED, rejectionCode is required.",
  "title": "LCIM V2 compact invocation record (run store projection)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaName",
    "schemaVersion",
    "invocationId",
    "runId",
    "workUnitId",
    "status",
    "provider",
    "model",
    "role",
    "reasoningEffort",
    "startedAt",
    "completedAt",
    "assessedAt",
    "reconciledAt"
  ],
  "properties": {
    "schemaName": { "const": "lcim.invocation" },
    "schemaVersion": { "const": "1.0.0" },
    "invocationId": { "type": "string", "pattern": "^lcim_inv_[0-9a-f]{32}$" },
    "runId": { "type": "string", "pattern": "^lcim_run_[0-9a-f]{32}$" },
    "workUnitId": { "type": "string", "pattern": "^lcim_wu_[0-9a-f]{32}$" },
    "status": {
      "enum": ["STARTED", "COMPLETED", "ASSESSED", "ORPHANED", "SUPERSEDED"]
    },
    "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
    "model": { "type": "string", "minLength": 1, "maxLength": 100 },
    "role": { "enum": ["WORKER", "SOL", "SOL_PRO"] },
    "reasoningEffort": { "type": "string", "minLength": 1, "maxLength": 100 },
    "startedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "completedAt": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "assessedAt": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "reconciledAt": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "outcome": {
      "enum": ["SUCCESS", "FAILURE", "TIMEOUT", "TRANSPORT_ERROR", "CANCELED"]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens", "totalTokens"],
      "properties": {
        "inputTokens": { "type": "integer" },
        "outputTokens": { "type": "integer" },
        "totalTokens": { "type": "integer" }
      }
    },
    "errorCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "rejectionCode": {
      "enum": [
        "TRANSPORT_MALFORMED",
        "SCHEMA_MISMATCH",
        "SEMANTIC_CONFLATION",
        "WRONG_BASE",
        "SCOPE_VIOLATION",
        "UNRESOLVED_SEMANTICS",
        "UNSUPPORTED_CLAIM",
        "INCOMPLETE_LEDGER",
        "BUDGET_EXHAUSTED",
        "SECRET_DENIED_PATH",
        "SOL_ASK_INVALID"
      ]
    },
    "assessmentResult": { "enum": ["ACCEPTED", "REJECTED"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "reconciliationReason": {
      "enum": [
        "CRASH_AFTER_START",
        "CRASH_AFTER_COMPLETION",
        "DUPLICATE_LIFECYCLE",
        "OTHER"
      ]
    },
    "supersededByInvocationId": {
      "type": "string",
      "pattern": "^lcim_inv_[0-9a-f]{32}$"
    }
  }
}

{
  "name": "lcim",
  "version": "2.0.0-dev.0",
  "private": true,
  "description": "Low Cost Implementation Model — V2 controller (Sprint 00 foundation baseline)",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "lcim": "bin/lcim.mjs"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:smoke": "node --test \"tests/smoke/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:guards": "node --test \"tests/guards/*.test.mjs\"",
    "test:audit": "node --test \"tests/audit/*.test.mjs\"",
    "test:compat:v1": "node --test \"tests/compat/v1/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.mjs\"",
    "test:cli": "node --test \"tests/smoke/*.test.mjs\" \"tests/integration/*.test.mjs\"",
    "check": "npm test"
  }
}
